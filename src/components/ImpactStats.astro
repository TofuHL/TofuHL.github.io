---
import { getDict, pick, type Locale } from '../i18n/ui';
import impactData from '../data/impact-stats.json';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = getDict(locale);
---

<section class="impact-stats section" aria-labelledby="impact-stats-title">
  <div class="container">
    <p class="eyebrow">{dict.impact.eyebrow}</p>
    <h2 id="impact-stats-title">{dict.impact.title}</h2>
    <div class="impact-stats__grid">
      {impactData.stats.map((stat) => (
        <div class="impact-stats__item fade-in-up">
          <span class="impact-stats__value" data-countup={stat.value}>0</span>
          <span class="impact-stats__label">{String(pick(dict, stat.labelKey))}</span>
          {stat.source && (
            <span class="impact-stats__source text-secondary">{dict.common.source}: {stat.source} ({stat.sourceDate})</span>
          )}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .impact-stats__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 40px;
  }
  .impact-stats__item {
    padding: 28px 20px;
    border-radius: var(--radius-md);
    background: var(--color-bg-warm);
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .impact-stats__value {
    font-family: var(--font-serif);
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 600;
    color: var(--color-azure);
  }
  .impact-stats__label { font-weight: 600; font-size: 15px; }
  .impact-stats__source { font-size: 11.5px; line-height: 1.4; }

  @media (max-width: 900px) {
    .impact-stats__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .impact-stats__grid { grid-template-columns: 1fr; }
  }
</style>
