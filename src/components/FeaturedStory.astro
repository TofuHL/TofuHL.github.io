---
import { getCollection } from 'astro:content';
import { getDict, localizedPath, type Locale } from '../i18n/ui';
import PhotoPlaceholder from './PhotoPlaceholder.astro';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = getDict(locale);

const allStories = await getCollection('stories', ({ id }) => id.startsWith(`${locale}/`));
const featured = allStories.find((s) => s.data.featured) ?? allStories[0];
const slug = featured ? featured.slug.replace(`${locale}/`, '') : '';
---

{featured && (
  <section class="featured-story section" aria-labelledby="featured-story-title">
    <div class="container featured-story__grid">
      <PhotoPlaceholder caption={featured.data.photoAlt} ratio="5 / 4" class="featured-story__photo" />
      <div class="featured-story__content fade-in-up">
        <p class="eyebrow">{dict.featuredStory.eyebrow}</p>
        <h2 id="featured-story-title">{featured.data.title}</h2>
        <p class="text-secondary">{featured.data.summary}</p>
        <a href={`${localizedPath(locale, 'stories')}${slug}/`} class="btn btn-secondary">
          {dict.featuredStory.readMore}
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .featured-story__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .featured-story__content { display: flex; flex-direction: column; gap: 4px; }
  .featured-story__content .btn { align-self: flex-start; margin-top: 12px; }

  @media (max-width: 820px) {
    .featured-story__grid { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
