---
import { getDict, localizedPath, type Locale } from '../i18n/ui';
import howItHelps from '../data/how-it-helps.json';
import { pick } from '../i18n/ui';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = getDict(locale);

const tiers = howItHelps.map((tier) => ({
  amount: tier.amount,
  title: String(pick(dict, tier.titleKey)),
  desc: String(pick(dict, tier.descKey)),
}));

const confirmationHref = localizedPath(locale, 'donate/confirmation');
---

<div class="donation-panel" data-donation-panel hidden>
  <div class="donation-panel__backdrop" data-donation-close tabindex="-1"></div>
  <div
    class="donation-panel__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="donation-panel-title"
    data-donation-dialog
  >
    <button type="button" class="donation-panel__close" data-donation-close aria-label={dict.donationPanel.closeLabel}>
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M2 2l14 14M16 2 2 16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>

    <h2 id="donation-panel-title" class="donation-panel__title">{dict.donationPanel.title}</h2>
    <p class="donation-panel__subtitle text-secondary">{dict.donationPanel.subtitle}</p>

    <form
      class="donation-form"
      data-donation-form
      method="get"
      action={confirmationHref}
    >
      <div class="donation-form__toggle" role="radiogroup" aria-label={dict.donationPanel.oneOff}>
        <button type="button" class="donation-form__toggle-btn is-active" data-frequency="once" aria-pressed="true">
          {dict.donationPanel.oneOff}
        </button>
        <button type="button" class="donation-form__toggle-btn" data-frequency="monthly" aria-pressed="false">
          {dict.donationPanel.monthly}
        </button>
      </div>

      <fieldset class="donation-form__amounts">
        <legend>{dict.donationPanel.presetLabel}</legend>
        <div class="donation-form__amount-grid">
          {tiers.map((tier, i) => (
            <label class="donation-form__amount">
              <input type="radio" name="amount" value={tier.amount} checked={i === 1} />
              <span class="donation-form__amount-value">{tier.amount.toLocaleString()} kr</span>
              <span class="donation-form__amount-desc">{tier.desc}</span>
            </label>
          ))}
        </div>
        <label class="donation-form__custom">
          <span>{dict.donationPanel.customAmount}</span>
          <input type="number" name="customAmount" min="10" step="10" placeholder={dict.donationPanel.customPlaceholder} />
        </label>
      </fieldset>

      <label class="donation-form__checkbox">
        <input type="checkbox" name="coverFees" checked />
        <span>
          <strong>{dict.donationPanel.coverFees}</strong>
          <span class="text-secondary">{dict.donationPanel.coverFeesDesc}</span>
        </span>
      </label>

      <label class="donation-form__checkbox">
        <input type="checkbox" name="taxDeduction" />
        <span>
          <strong>{dict.donationPanel.taxDeduction}</strong>
          <span class="text-secondary">{dict.donationPanel.taxDeductionDesc}</span>
        </span>
      </label>

      <label class="donation-form__text">
        <span>{dict.donationPanel.dedication}</span>
        <input type="text" name="dedication" placeholder={dict.donationPanel.dedicationPlaceholder} />
      </label>

      <fieldset class="donation-form__payment">
        <legend>{dict.donationPanel.paymentMethods}</legend>
        <div class="donation-form__payment-grid">
          <label class="donation-form__payment-option">
            <input type="radio" name="paymentMethod" value="card" checked />
            <span>Card</span>
          </label>
          <label class="donation-form__payment-option">
            <input type="radio" name="paymentMethod" value="applepay" />
            <span>Apple Pay</span>
          </label>
          <label class="donation-form__payment-option">
            <input type="radio" name="paymentMethod" value="googlepay" />
            <span>Google Pay</span>
          </label>
          <label class="donation-form__payment-option">
            <input type="radio" name="paymentMethod" value="paypal" />
            <span>PayPal</span>
          </label>
          <label class="donation-form__payment-option">
            <input type="radio" name="paymentMethod" value="swish" />
            <span>Swish</span>
          </label>
        </div>
      </fieldset>

      <button type="submit" class="btn btn-primary btn-block">{dict.donationPanel.continueBtn}</button>
      <p class="donation-form__secure text-secondary">{dict.donationPanel.secureNote}</p>
    </form>
  </div>
</div>

<style>
  .donation-panel[hidden] { display: none; }
  .donation-panel {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .donation-panel__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(17, 20, 24, 0.55);
  }
  .donation-panel__dialog {
    position: relative;
    background: var(--color-bg);
    border-radius: var(--radius-lg);
    padding: 36px;
    max-width: 460px;
    width: calc(100% - 32px);
    max-height: 90vh;
    overflow-y: auto;
    box-shadow: 0 24px 60px rgba(17, 20, 24, 0.25);
  }
  .donation-panel__close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-text);
  }
  .donation-panel__title { font-size: 24px; margin-bottom: 6px; padding-right: 40px; }
  .donation-panel__subtitle { font-size: 14px; margin-bottom: 24px; }

  .donation-form { display: flex; flex-direction: column; gap: 22px; }
  .donation-form__toggle {
    display: flex;
    background: var(--color-bg-warm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 4px;
  }
  .donation-form__toggle-btn {
    flex: 1;
    background: none;
    border: none;
    border-radius: 5px;
    padding: 9px;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    color: var(--color-text-secondary);
  }
  .donation-form__toggle-btn.is-active { background: var(--color-bg); color: var(--color-azure); box-shadow: var(--shadow-card); }

  fieldset { border: none; padding: 0; margin: 0; }
  legend { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-secondary); padding: 0; margin-bottom: 10px; }

  .donation-form__amount-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }
  .donation-form__amount {
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 12px 8px;
    text-align: center;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .donation-form__amount:has(input:checked) { border-color: var(--color-azure); background: rgba(0, 87, 183, 0.05); }
  .donation-form__amount input { position: absolute; opacity: 0; pointer-events: none; }
  .donation-form__amount-value { font-weight: 700; font-size: 15px; }
  .donation-form__amount-desc { font-size: 11.5px; color: var(--color-text-secondary); line-height: 1.3; }

  .donation-form__custom { display: flex; flex-direction: column; gap: 6px; margin-top: 12px; font-size: 13px; font-weight: 600; }
  .donation-form__custom input, .donation-form__text input {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    font-size: 15px;
    font-family: var(--font-ui);
  }

  .donation-form__checkbox {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 13.5px;
    cursor: pointer;
  }
  .donation-form__checkbox input { margin-top: 3px; }
  .donation-form__checkbox span { display: flex; flex-direction: column; gap: 2px; }

  .donation-form__text { display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600; }

  .donation-form__payment-grid { display: flex; flex-wrap: wrap; gap: 8px; }
  .donation-form__payment-option {
    border: 1.5px solid var(--color-border);
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 13px;
    cursor: pointer;
  }
  .donation-form__payment-option:has(input:checked) { border-color: var(--color-azure); color: var(--color-azure); font-weight: 600; }
  .donation-form__payment-option input { position: absolute; opacity: 0; pointer-events: none; }

  .donation-form__secure { font-size: 12px; text-align: center; margin: 0; }
</style>

<script>
  const panel = document.querySelector<HTMLElement>('[data-donation-panel]');
  const dialog = document.querySelector<HTMLElement>('[data-donation-dialog]');
  let lastFocused: HTMLElement | null = null;

  function openPanel(trigger?: HTMLElement) {
    if (!panel) return;
    lastFocused = trigger ?? (document.activeElement as HTMLElement);
    panel.hidden = false;
    document.body.style.overflow = 'hidden';
    const focusable = dialog?.querySelector<HTMLElement>('button, input, a');
    focusable?.focus();
  }

  function closePanel() {
    if (!panel) return;
    panel.hidden = true;
    document.body.style.overflow = '';
    lastFocused?.focus();
  }

  document.querySelectorAll<HTMLElement>('[data-open-donation]').forEach((btn) => {
    btn.addEventListener('click', () => openPanel(btn));
  });
  document.querySelectorAll<HTMLElement>('[data-donation-close]').forEach((el) => {
    el.addEventListener('click', closePanel);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel && !panel.hidden) closePanel();
    if (e.key === 'Tab' && panel && !panel.hidden && dialog) {
      const focusables = Array.from(
        dialog.querySelectorAll<HTMLElement>('button, input, a, [tabindex]:not([tabindex="-1"])'),
      ).filter((el) => !el.hasAttribute('disabled'));
      if (!focusables.length) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  document.querySelectorAll<HTMLButtonElement>('[data-frequency]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('[data-frequency]').forEach((b) => {
        b.classList.remove('is-active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-pressed', 'true');
      const form = document.querySelector<HTMLFormElement>('[data-donation-form]');
      let hidden = form?.querySelector<HTMLInputElement>('input[name="frequency"]');
      if (!hidden && form) {
        hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'frequency';
        form.appendChild(hidden);
      }
      if (hidden) hidden.value = btn.dataset.frequency ?? 'once';
    });
  });
</script>
