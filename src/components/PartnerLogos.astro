---
import { getCollection } from 'astro:content';
import { getDict, type Locale } from '../i18n/ui';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = getDict(locale);
const partners = await getCollection('partners');
---

<section class="partner-logos section" aria-labelledby="partner-logos-title">
  <div class="container">
    <p class="eyebrow">{dict.partners.eyebrow}</p>
    <h2 id="partner-logos-title" class="visually-hidden">{dict.partners.title}</h2>
    <ul class="partner-logos__row">
      {partners.map((partner) => (
        <li class="partner-logos__item" title={partner.data.description[locale] ?? partner.data.description.en}>
          <span class="partner-logos__mark" aria-hidden="true">
            {partner.data.name.slice(0, 2).toUpperCase()}
          </span>
          <span class="partner-logos__name">{partner.data.name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .partner-logos__row {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
  }
  .partner-logos__item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-warm);
  }
  .partner-logos__mark {
    width: 30px;
    height: 30px;
    border-radius: 6px;
    background: linear-gradient(135deg, var(--color-azure), var(--color-yellow));
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    flex-shrink: 0;
  }
  .partner-logos__name { font-size: 14px; font-weight: 600; }
</style>
