---
import { getDict, pick, type Locale } from '../i18n/ui';
import howItHelps from '../data/how-it-helps.json';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = getDict(locale);
---

<section class="how-it-helps section" aria-labelledby="how-it-helps-title">
  <div class="container">
    <p class="eyebrow">{dict.help.eyebrow}</p>
    <h2 id="how-it-helps-title">{dict.help.title}</h2>
    <div class="how-it-helps__grid">
      {howItHelps.map((tier) => (
        <div class="card how-it-helps__card fade-in-up">
          <span class="how-it-helps__amount">{String(pick(dict, tier.titleKey))}</span>
          <p class="how-it-helps__desc">{String(pick(dict, tier.descKey))}</p>
          <button type="button" class="btn btn-secondary btn-block" data-open-donation>
            {dict.help.ctaDonate}
          </button>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .how-it-helps__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }
  .how-it-helps__card { display: flex; flex-direction: column; gap: 14px; }
  .how-it-helps__amount {
    font-family: var(--font-serif);
    font-size: 32px;
    font-weight: 600;
    color: var(--color-azure);
  }
  .how-it-helps__desc { flex-grow: 1; font-size: 15.5px; }

  @media (max-width: 820px) {
    .how-it-helps__grid { grid-template-columns: 1fr; }
  }
</style>
