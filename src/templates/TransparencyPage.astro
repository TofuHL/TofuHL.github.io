---
import BaseLayout from '../layouts/BaseLayout.astro';
import AllocationChart from '../components/charts/AllocationChart.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { getDict, type Locale } from '../i18n/ui';
import reportsData from '../data/reports.json';
import legal from '../data/legal.json';
import type { Report } from '../data/types';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = getDict(locale);
const p = dict.pages.transparency;
const reports = reportsData as Report[];

const dateFormat = new Intl.DateTimeFormat(locale === 'uk' ? 'uk-UA' : locale === 'sv' ? 'sv-SE' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout locale={locale} path="transparency" title={p.title} description={p.metaDescription}>
  <section class="section">
    <div class="container transparency__hero">
      <p class="eyebrow">{p.heroEyebrow}</p>
      <h1>{p.heroTitle}</h1>
    </div>
  </section>

  <section class="section" aria-labelledby="allocation-title">
    <div class="container">
      <h2 id="allocation-title">{p.allocationTitle}</h2>
      <p class="transparency__body">{p.allocationBody}</p>
      <AllocationChart locale={locale} />
    </div>
  </section>

  <section class="section transparency__overhead">
    <div class="container">
      <h2>{p.overheadTitle}</h2>
      <p class="transparency__body">{p.overheadBody}</p>
    </div>
  </section>

  <section class="section" id="procurement">
    <div class="container">
      <h2>{p.procurementTitle}</h2>
      <p class="transparency__body">{p.procurementBody}</p>
    </div>
  </section>

  <section class="section transparency__safeguarding" id="safeguarding">
    <div class="container">
      <h2>{p.safeguardingTitle}</h2>
      <p class="transparency__body">{p.safeguardingBody}</p>
    </div>
  </section>

  <section class="section" id="complaints">
    <div class="container">
      <h2>{p.complaintsTitle}</h2>
      <p class="transparency__body">{p.complaintsBody}</p>
    </div>
  </section>

  <section class="section transparency__reports" aria-labelledby="reports-title">
    <div class="container">
      <h2 id="reports-title">{p.reportsTitle}</h2>
      <p class="text-secondary">{p.reportsIntro}</p>
      <ul class="transparency__reports-list">
        {reports.map((r) => (
          <li>
            <a href={r.file} download>
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 2v9m0 0 3.5-3.5M9 11 5.5 7.5M3 14h12v2H3z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {r.title}
            </a>
            <span class="text-secondary">{dateFormat.format(new Date(r.date))}</span>
          </li>
        ))}
      </ul>
      {(legal.fundraisingLicense[locale] ?? legal.fundraisingLicense.en) && (
        <p class="transparency__registry text-secondary">{legal.fundraisingLicense[locale] ?? legal.fundraisingLicense.en}</p>
      )}
    </div>
  </section>

  <section class="section" id="privacy">
    <div class="container">
      <h2>{p.privacyTitle}</h2>
      <p class="transparency__body">{p.privacyBody}</p>
    </div>
  </section>

  <ClosingCta locale={locale} />
</BaseLayout>

<style>
  .transparency__hero { max-width: 780px; }
  .transparency__body { max-width: 74ch; font-size: 16.5px; }
  .transparency__overhead, .transparency__safeguarding { background: var(--color-bg-warm); }
  .transparency__reports-list { list-style: none; margin: 24px 0 16px; padding: 0; display: flex; flex-direction: column; gap: 0; max-width: 560px; }
  .transparency__reports-list li { display: flex; align-items: center; justify-content: space-between; padding: 14px 0; border-bottom: 1px solid var(--color-border); }
  .transparency__reports-list a { display: flex; align-items: center; gap: 8px; font-weight: 600; }
  .transparency__registry { font-size: 13px; }
</style>
