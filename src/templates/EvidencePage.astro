---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingCta from '../components/ClosingCta.astro';
import { getDict, type Locale } from '../i18n/ui';
import reportsData from '../data/reports.json';
import type { Report } from '../data/types';

export interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const dict = getDict(locale);
const p = dict.pages.evidence;

const partners = await getCollection('partners');
const testimonials = await getCollection('testimonials');
const press = (await getCollection('press')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const reports = reportsData as Report[];

const dateFormat = new Intl.DateTimeFormat(locale === 'uk' ? 'uk-UA' : locale === 'sv' ? 'sv-SE' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout locale={locale} path="evidence" title={p.title} description={p.metaDescription}>
  <section class="section">
    <div class="container evidence__hero">
      <p class="eyebrow">{p.heroEyebrow}</p>
      <h1>{p.heroTitle}</h1>
    </div>
  </section>

  <section class="section" aria-labelledby="partners-title">
    <div class="container">
      <h2 id="partners-title">{p.partnersTitle}</h2>
      {partners.length > 0 ? (
        <div class="evidence__partners-grid">
          {partners.map((partner) => (
            <div class="card evidence__partner fade-in-up">
              <span class="evidence__partner-mark" aria-hidden="true">{partner.data.name.slice(0, 2).toUpperCase()}</span>
              <h3>{partner.data.name}</h3>
              <p class="text-secondary">{partner.data.description[locale] ?? partner.data.description.en}</p>
              <span class="badge">{partner.data.kind}</span>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-secondary evidence__empty">{p.partnersEmpty}</p>
      )}
    </div>
  </section>

  <section class="section evidence__testimonials" aria-labelledby="testimonials-title">
    <div class="container">
      <h2 id="testimonials-title">{p.testimonialsTitle}</h2>
      {testimonials.length > 0 ? (
        <div class="evidence__testimonials-grid">
          {testimonials.map((t) => (
            <figure class="card fade-in-up">
              <blockquote>{t.data.quote[locale] ?? t.data.quote.en}</blockquote>
              <figcaption>
                <strong>{t.data.name}</strong>
                <span class="text-secondary">{t.data.role[locale] ?? t.data.role.en}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      ) : (
        <p class="text-secondary evidence__empty">{p.testimonialsEmpty}</p>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="press-title">
    <div class="container">
      <h2 id="press-title">{p.pressTitle}</h2>
      {press.length > 0 ? (
        <ul class="evidence__press-list">
          {press.map((item) => (
            <li>
              <span class="evidence__press-outlet">{item.data.outlet}</span>
              <a href={item.data.url} rel="noopener" target="_blank">{item.data.headline[locale] ?? item.data.headline.en}</a>
              <time datetime={item.data.date} class="text-secondary">{item.data.date}</time>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-secondary evidence__empty">{p.pressEmpty}</p>
      )}
    </div>
  </section>

  <section class="section evidence__field" aria-labelledby="field-title">
    <div class="container">
      <h2 id="field-title">{p.fieldEvidenceTitle}</h2>
      <p class="text-secondary evidence__field-intro">{p.fieldEvidenceIntro}</p>
      <p class="text-secondary evidence__empty">{p.fieldEvidenceEmpty}</p>
    </div>
  </section>

  <section class="section evidence__financial" aria-labelledby="financial-title">
    <div class="container">
      <h2 id="financial-title">{p.financialTitle}</h2>
      <p class="text-secondary evidence__financial-intro">{p.financialIntro}</p>
      {reports.length > 0 ? (
        <ul class="evidence__reports-list">
          {reports.map((r) => (
            <li>
              <a href={r.file} download>
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 2v9m0 0 3.5-3.5M9 11 5.5 7.5M3 14h12v2H3z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {r.title}
              </a>
              <span class="text-secondary">{dateFormat.format(new Date(r.date))}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-secondary evidence__empty">{p.reportsEmpty}</p>
      )}
    </div>
  </section>

  <section class="section evidence__endorsements" aria-labelledby="endorsements-title">
    <div class="container">
      <h2 id="endorsements-title">{p.endorsementsTitle}</h2>
      <p class="text-secondary">{p.endorsementsNote}</p>
    </div>
  </section>

  <ClosingCta locale={locale} />
</BaseLayout>

<style>
  .evidence__hero { max-width: 780px; }
  .evidence__empty { margin-top: 24px; max-width: 60ch; }
  .evidence__partners-grid, .evidence__testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 28px; }
  .evidence__partner { display: flex; flex-direction: column; gap: 8px; align-items: flex-start; }
  .evidence__partner-mark {
    width: 34px; height: 34px; border-radius: 8px;
    background: linear-gradient(135deg, var(--color-azure), var(--color-yellow));
    color: #fff; display: flex; align-items: center; justify-content: center;
    font-size: 12px; font-weight: 700;
  }
  .evidence__testimonials { background: var(--color-bg-warm); }
  .evidence__testimonials-grid blockquote { margin: 0 0 16px; font-family: var(--font-serif); font-size: 17px; font-style: italic; line-height: 1.6; }
  .evidence__testimonials-grid figcaption { display: flex; flex-direction: column; gap: 2px; font-size: 13.5px; }

  .evidence__press-list { list-style: none; margin: 28px 0 0; padding: 0; display: flex; flex-direction: column; gap: 0; }
  .evidence__press-list li { display: grid; grid-template-columns: 160px 1fr 120px; gap: 16px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--color-border); }
  .evidence__press-outlet { font-weight: 700; font-size: 13.5px; }

  .evidence__field-intro { max-width: 68ch; }
  .evidence__field-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 24px; }
  .evidence__field-meta { font-size: 13px; margin-top: 10px; }

  .evidence__financial-intro { max-width: 68ch; }
  .evidence__reports-list { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-direction: column; gap: 0; max-width: 560px; }
  .evidence__reports-list li { display: flex; align-items: center; justify-content: space-between; padding: 14px 0; border-bottom: 1px solid var(--color-border); }
  .evidence__reports-list a { display: flex; align-items: center; gap: 8px; font-weight: 600; }

  @media (max-width: 900px) {
    .evidence__partners-grid, .evidence__testimonials-grid, .evidence__field-grid { grid-template-columns: 1fr 1fr; }
    .evidence__press-list li { grid-template-columns: 1fr; gap: 4px; }
  }
  @media (max-width: 560px) {
    .evidence__partners-grid, .evidence__testimonials-grid, .evidence__field-grid { grid-template-columns: 1fr; }
  }
</style>
