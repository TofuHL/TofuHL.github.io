---
import '@fontsource-variable/inter';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DonationPanel from '../components/DonationPanel.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getDict, locales, localeBcp47, type Locale } from '../i18n/ui';

export interface Props {
  locale: Locale;
  /** route path with no leading/trailing slash and no locale prefix, e.g. "who-we-are" or "" for home */
  path: string;
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { locale, path, title, description, ogImage, noindex = false } = Astro.props;
const dict = getDict(locale);
const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://tofuhl.github.io';
const cleanPath = path.replace(/^\/+/, '').replace(/\/+$/, '');
const canonicalPath = cleanPath ? `/${locale}/${cleanPath}/` : `/${locale}/`;
const canonicalUrl = `${site}${canonicalPath}`;
const pageDescription = description ?? dict.meta.defaultDescription;
const fullTitle = `${title} — ${dict.meta.siteName}`;
const ogImageUrl = ogImage ?? `${site}/og-default.svg`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {locales.map((l) => (
      <link
        rel="alternate"
        hreflang={localeBcp47[l]}
        href={`${site}/${l}/${cleanPath ? cleanPath + '/' : ''}`}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${site}/en/${cleanPath ? cleanPath + '/' : ''}`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={dict.meta.siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={localeBcp47[locale].replace('-', '_')} />
    {locales.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={localeBcp47[l].replace('-', '_')} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'NGO',
      name: 'Samma färger',
      alternateName: 'Insamlingsstiftelsen Samma färger',
      url: site,
      logo: `${site}/favicon.svg`,
      description: dict.meta.defaultDescription,
      areaServed: 'UA',
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'SE',
      },
      sameAs: [],
      potentialAction: {
        '@type': 'DonateAction',
        name: dict.nav.donate,
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${site}/${locale}/get-involved/`,
          actionPlatform: [
            'http://schema.org/DesktopWebPlatform',
            'http://schema.org/MobileWebPlatform',
          ],
        },
        recipient: {
          '@type': 'NGO',
          name: 'Samma färger',
        },
      },
    })} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{dict.common.skipToContent}</a>
    <Header locale={locale} currentPath={cleanPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} currentPath={cleanPath} />
    <DonationPanel locale={locale} />
    <CookieConsent locale={locale} />
    <script>
      const revealEls = document.querySelectorAll<HTMLElement>('.fade-in-up');
      if ('IntersectionObserver' in window && revealEls.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          // Generous margin so fast/large scroll jumps can't skip an element
          // between sampled frames without ever registering as intersecting.
          { threshold: 0, rootMargin: '200px 0px 200px 0px' },
        );
        revealEls.forEach((el) => io.observe(el));
        // Safety net: never leave content permanently invisible if the
        // observer misses an element for any reason (fast scroll, reduced
        // sampling, etc.) — this is presentational motion, not gating.
        window.setTimeout(() => {
          revealEls.forEach((el) => el.classList.add('is-visible'));
          io.disconnect();
        }, 2500);
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const counters = document.querySelectorAll<HTMLElement>('[data-countup]');
      if (counters.length && 'IntersectionObserver' in window) {
        const format = (n: number) => Math.round(n).toLocaleString();
        const animate = (el: HTMLElement) => {
          const target = Number(el.dataset.countup ?? '0');
          if (prefersReducedMotion || !target) {
            el.textContent = format(target);
            return;
          }
          const duration = 1200;
          const start = performance.now();
          const step = (now: number) => {
            const progress = Math.min(1, (now - start) / duration);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = format(target * eased);
            if (progress < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        };
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                animate(entry.target as HTMLElement);
                io.unobserve(entry.target);
              }
            }
          },
          // Generous margin: same rationale as the fade-in-up observer above.
          { threshold: 0, rootMargin: '200px 0px 200px 0px' },
        );
        counters.forEach((el) => io.observe(el));
        // Safety net: these are real figures, not decoration — never leave
        // one stuck at "0" if the observer misses it for any reason.
        window.setTimeout(() => {
          counters.forEach((el) => {
            if (el.textContent === '0') el.textContent = format(Number(el.dataset.countup ?? '0'));
          });
          io.disconnect();
        }, 2500);
      } else {
        counters.forEach((el) => {
          el.textContent = Math.round(Number(el.dataset.countup ?? '0')).toLocaleString();
        });
      }
    </script>
  </body>
</html>
