---
import '@fontsource-variable/inter';

export interface Props {
  title: string;
  active: 'calendar' | 'mail' | 'settings';
}
const { title, active } = Astro.props;
const nav = [
  { key: 'calendar', href: '/planner/', label: 'Calendar' },
  { key: 'mail', href: '/planner/mail/', label: 'Mail' },
  { key: 'settings', href: '/planner/settings/', label: 'Settings' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · My Planner</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='8' fill='%234f46e5'/><rect x='7' y='9' width='18' height='16' rx='3' fill='none' stroke='white' stroke-width='2.4'/><path d='M7 14h18M12 6v5M20 6v5' stroke='white' stroke-width='2.4' stroke-linecap='round'/></svg>" />
    <!-- Apply the saved theme before the page paints, so there is no flash. -->
    <script is:inline>
      (function () {
        var t = 'system';
        try { t = localStorage.getItem('planner.theme') || 'system'; } catch (e) {}
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body>
    <div class="bg" aria-hidden="true">
      <div class="aurora a1"></div>
      <div class="aurora a2"></div>
      <div class="aurora a3"></div>
      <canvas id="particles"></canvas>
    </div>

    <header class="topbar">
      <a class="brand" href="/planner/">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18"><rect x="3" y="5" width="18" height="16" rx="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M3 10h18M8 2.5v4M16 2.5v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </span>
        <span>My Planner</span>
      </a>
      <nav class="tabs" aria-label="Sections">
        {nav.map((n) => (
          <a href={n.href} class:list={['tab', { active: active === n.key }]} aria-current={active === n.key ? 'page' : undefined}>
            {n.label}
          </a>
        ))}
      </nav>
      <div class="topbar-actions">
        <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch colour theme" title="Light / dark mode">
          <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        </button>
        <button class="btn btn-primary ai-open" id="ai-open" type="button">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 2l1.9 5.6L19.5 9.5l-5.6 1.9L12 17l-1.9-5.6L4.5 9.5l5.6-1.9z" fill="currentColor"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z" fill="currentColor"/></svg>
          <span>Assistant</span>
        </button>
      </div>
    </header>

    <main class="page">
      <slot />
    </main>

    <!-- AI assistant drawer, available on every page -->
    <aside class="drawer" id="ai-drawer" aria-label="AI assistant" hidden>
      <div class="drawer-head">
        <div>
          <strong>Your assistant</strong>
          <p class="muted small">Ask about your week, or say "add a shift Friday 9–17".</p>
        </div>
        <div class="row gap-xs">
          <button class="btn btn-ghost btn-sm" id="ai-new" type="button">New chat</button>
          <button class="icon-btn" id="ai-close" type="button" aria-label="Close assistant">✕</button>
        </div>
      </div>
      <div class="chat-log" id="ai-log" aria-live="polite"></div>
      <div class="chat-status muted small" id="ai-status"></div>
      <form class="chat-form" id="ai-form">
        <textarea id="ai-input" rows="2" placeholder="Message your assistant…" aria-label="Message"></textarea>
        <button class="btn btn-primary" type="submit" id="ai-send">Send</button>
      </form>
    </aside>
    <div class="scrim" id="ai-scrim" hidden></div>

    <div class="toast" id="toast" role="status" hidden></div>

    <script>
      import { initShell } from '../planner/shell';
      import { initParticles } from '../planner/particles';
      initShell();
      initParticles(document.getElementById('particles') as HTMLCanvasElement);
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f6f7fb;
    --surface: #ffffff;
    --surface-2: #f1f3f9;
    --border: #e3e6ef;
    --text: #161a26;
    --muted: #5d6478;
    --accent: #4f46e5;
    --accent-hover: #4338ca;
    --accent-soft: #eef0ff;
    --on-accent: #ffffff;
    --danger: #c62f3b;
    --shadow: 0 1px 2px rgb(16 24 40 / 0.06), 0 4px 16px rgb(16 24 40 / 0.06);
    --shadow-lg: 0 12px 40px rgb(16 24 40 / 0.18);
    --t-shift: #2563eb;
    --t-plan: #059669;
    --t-meeting: #7c3aed;
    --t-reminder: #d97706;
    --t-other: #64748b;
    --radius: 16px;
    --glass: rgb(255 255 255 / 0.8);
    --glass-strong: rgb(255 255 255 / 0.86);
    --glass-border: rgb(255 255 255 / 0.7);
    --grad: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #ec4899 100%);
    --glow-1: rgb(99 102 241 / 0.30);
    --glow-2: rgb(236 72 153 / 0.22);
    --glow-3: rgb(14 165 233 / 0.22);
    --p1: #6366f1;
    --p2: #ec4899;
    --p3: #0ea5e9;
    --p-line: 99, 102, 241;
    --p-line-alpha: 0.18;
    --p-dot-alpha: 0.7;
  }
  :root[data-theme='dark'] {
    color-scheme: dark;
    --bg: #0e1118;
    --surface: #161a24;
    --surface-2: #1d2230;
    --border: #2a3142;
    --text: #e8ebf3;
    --muted: #98a0b5;
    --accent: #818cf8;
    --accent-hover: #a5b4fc;
    --accent-soft: #232846;
    --on-accent: #0e1118;
    --danger: #f87171;
    --shadow: 0 1px 2px rgb(0 0 0 / 0.4);
    --shadow-lg: 0 12px 40px rgb(0 0 0 / 0.5);
    --t-shift: #60a5fa;
    --t-plan: #34d399;
    --t-meeting: #a78bfa;
    --t-reminder: #fbbf24;
    --t-other: #94a3b8;
    --glass: rgb(22 26 36 / 0.74);
    --glass-strong: rgb(22 26 36 / 0.82);
    --glass-border: rgb(255 255 255 / 0.07);
    --grad: linear-gradient(135deg, #818cf8 0%, #a78bfa 50%, #f472b6 100%);
    --glow-1: rgb(99 102 241 / 0.28);
    --glow-2: rgb(236 72 153 / 0.16);
    --glow-3: rgb(34 211 238 / 0.14);
    --p1: #a5b4fc;
    --p2: #f9a8d4;
    --p3: #67e8f9;
    --p-line: 165, 180, 252;
    --p-line-alpha: 0.16;
    --p-dot-alpha: 0.8;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) {
      color-scheme: dark;
      --bg: #0e1118;
      --surface: #161a24;
      --surface-2: #1d2230;
      --border: #2a3142;
      --text: #e8ebf3;
      --muted: #98a0b5;
      --accent: #818cf8;
      --accent-hover: #a5b4fc;
      --accent-soft: #232846;
      --on-accent: #0e1118;
      --danger: #f87171;
      --shadow: 0 1px 2px rgb(0 0 0 / 0.4);
      --shadow-lg: 0 12px 40px rgb(0 0 0 / 0.5);
      --t-shift: #60a5fa;
      --t-plan: #34d399;
      --t-meeting: #a78bfa;
      --t-reminder: #fbbf24;
      --t-other: #94a3b8;
      --glass: rgb(22 26 36 / 0.74);
      --glass-strong: rgb(22 26 36 / 0.82);
      --glass-border: rgb(255 255 255 / 0.07);
      --grad: linear-gradient(135deg, #818cf8 0%, #a78bfa 50%, #f472b6 100%);
      --glow-1: rgb(99 102 241 / 0.28);
      --glow-2: rgb(236 72 153 / 0.16);
      --glow-3: rgb(34 211 238 / 0.14);
      --p1: #a5b4fc;
      --p2: #f9a8d4;
      --p3: #67e8f9;
      --p-line: 165, 180, 252;
      --p-line-alpha: 0.16;
      --p-dot-alpha: 0.8;
    }
  }

  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; }
  body {
    font-family: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
    background: var(--bg);
    color: var(--text);
    font-size: 15px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    transition: background-color 0.2s, color 0.2s;
  }
  a { color: var(--accent); }
  h1, h2, h3 { line-height: 1.2; margin: 0; letter-spacing: -0.01em; }
  h1 { font-size: 1.5rem; }
  h2 { font-size: 1.15rem; }
  h3 { font-size: 1rem; }
  .muted { color: var(--muted); }
  .small { font-size: 0.85rem; }
  .row { display: flex; align-items: center; }
  .gap-xs { gap: 6px; }
  .gap-sm { gap: 10px; }
  .wrap { flex-wrap: wrap; }
  .grow { flex: 1; }
  [hidden] { display: none !important; }

  /* animated background */
  .bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none; }
  .bg canvas { position: absolute; inset: 0; }
  .aurora { position: absolute; border-radius: 50%; will-change: transform; }
  .a1 { width: 46vmax; height: 46vmax; left: -12vmax; top: -16vmax; background: radial-gradient(closest-side, var(--glow-1), transparent); animation: drift1 26s ease-in-out infinite alternate; }
  .a2 { width: 40vmax; height: 40vmax; right: -14vmax; top: 18vh; background: radial-gradient(closest-side, var(--glow-2), transparent); animation: drift2 32s ease-in-out infinite alternate; }
  .a3 { width: 38vmax; height: 38vmax; left: 22vw; bottom: -22vmax; background: radial-gradient(closest-side, var(--glow-3), transparent); animation: drift3 29s ease-in-out infinite alternate; }
  @keyframes drift1 { to { transform: translate(12vw, 10vh) scale(1.12); } }
  @keyframes drift2 { to { transform: translate(-10vw, 14vh) scale(0.9); } }
  @keyframes drift3 { to { transform: translate(-8vw, -12vh) scale(1.1); } }
  .topbar, .page { position: relative; z-index: 1; }
  @media (prefers-reduced-motion: reduce) {
    .aurora, .page { animation: none !important; }
  }

  /* top bar */
  .topbar {
    position: sticky; top: 0; z-index: 20;
    display: flex; align-items: center; gap: 16px;
    padding: 10px 20px;
    background: var(--glass);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--glass-border);
    z-index: 20;
  }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; color: var(--text); text-decoration: none; }
  .brand-mark { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: var(--grad); color: #fff; box-shadow: 0 4px 14px var(--glow-1); }
  .brand span:last-child { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; font-size: 1.05rem; }
  .tabs { display: flex; gap: 4px; margin-left: 12px; }
  .tab { padding: 7px 14px; border-radius: 999px; color: var(--muted); text-decoration: none; font-weight: 500; }
  .tab:hover { background: var(--surface-2); color: var(--text); }
  .tab { transition: background 0.15s, color 0.15s; }
  .tab.active { background: var(--accent-soft); color: var(--accent); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 25%, transparent); }
  .topbar-actions { margin-left: auto; display: flex; align-items: center; gap: 8px; }

  /* buttons and inputs */
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    padding: 8px 14px; border-radius: 10px; border: 1px solid var(--border);
    background: var(--surface); color: var(--text); font: inherit; font-weight: 550;
    cursor: pointer; transition: background 0.15s, border-color 0.15s, transform 0.05s;
  }
  .btn:hover { background: var(--surface-2); }
  .btn:active { transform: translateY(1px); }
  .btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .btn-primary { background: var(--grad); background-size: 160% 160%; background-position: 0% 50%; border-color: transparent; color: #fff; box-shadow: 0 4px 16px var(--glow-1); transition: background-position 0.4s, box-shadow 0.2s, transform 0.05s; }
  .btn-primary:hover { background: var(--grad); background-size: 160% 160%; background-position: 100% 50%; border-color: transparent; box-shadow: 0 6px 22px var(--glow-1); }
  .btn-ghost { background: transparent; border-color: transparent; }
  .btn-danger { color: var(--danger); }
  .btn-sm { padding: 5px 10px; font-size: 0.85rem; border-radius: 8px; white-space: nowrap; }
  .icon-btn {
    display: grid; place-items: center; width: 36px; height: 36px; border-radius: 10px;
    border: 1px solid var(--border); background: var(--surface); color: var(--text); cursor: pointer; font: inherit;
  }
  .icon-btn:hover { background: var(--surface-2); }
  #theme-toggle .i-moon { display: none; }
  :root[data-theme='dark'] #theme-toggle .i-sun { display: none; }
  :root[data-theme='dark'] #theme-toggle .i-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) #theme-toggle .i-sun { display: none; }
    :root:not([data-theme='light']) #theme-toggle .i-moon { display: block; }
  }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  label { display: block; font-weight: 550; font-size: 0.875rem; margin-bottom: 4px; }
  input[type='text'], input[type='password'], input[type='date'], input[type='time'], input[type='number'], input[type='search'], select, textarea {
    width: 100%; padding: 9px 11px; border-radius: 10px; border: 1px solid var(--border);
    background: var(--surface); color: var(--text); font: inherit;
  }
  textarea { resize: vertical; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }

  .page { max-width: 1280px; margin: 0 auto; padding: 24px 20px 64px; animation: rise 0.45s ease-out both; }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } }
  .card {
    background: var(--glass); border: 1px solid var(--glass-border); border-radius: var(--radius);
    box-shadow: var(--shadow);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .card:hover { box-shadow: var(--shadow-lg); }
  h1 { background: linear-gradient(90deg, var(--text) 30%, var(--accent)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .card-pad { padding: 18px; }

  /* event type colours */
  .t-shift { --t: var(--t-shift); }
  .t-plan { --t: var(--t-plan); }
  .t-meeting { --t: var(--t-meeting); }
  .t-reminder { --t: var(--t-reminder); }
  .t-other { --t: var(--t-other); }
  .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--t); flex: none; }
  .pill {
    display: inline-flex; align-items: center; gap: 6px; padding: 2px 9px; border-radius: 999px;
    font-size: 0.75rem; font-weight: 600; color: var(--t);
    background: color-mix(in srgb, var(--t) 14%, transparent);
  }

  /* AI drawer */
  .drawer {
    position: fixed; z-index: 40; top: 0; right: 0; bottom: 0; width: min(440px, 100vw);
    display: flex; flex-direction: column; background: var(--glass-strong);
    backdrop-filter: blur(22px) saturate(1.4); -webkit-backdrop-filter: blur(22px) saturate(1.4);
    border-left: 1px solid var(--glass-border); box-shadow: var(--shadow-lg);
    animation: slide-in 0.2s ease-out;
  }
  @keyframes slide-in { from { transform: translateX(30px); opacity: 0; } }
  .drawer-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding: 16px; border-bottom: 1px solid var(--border); }
  .drawer-head p { margin: 2px 0 0; }
  .scrim { position: fixed; inset: 0; z-index: 35; background: rgb(0 0 0 / 0.25); backdrop-filter: blur(2px); }
  .chat-log { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .bubble { max-width: 88%; padding: 10px 13px; border-radius: 14px; white-space: pre-wrap; word-wrap: break-word; }
  .bubble.user { align-self: flex-end; background: var(--grad); color: #fff; border-bottom-right-radius: 4px; box-shadow: 0 4px 14px var(--glow-1); }
  .bubble { animation: pop 0.25s ease-out both; }
  @keyframes pop { from { opacity: 0; transform: translateY(6px) scale(0.98); } }
  .bubble.assistant { align-self: flex-start; background: var(--surface-2); border-bottom-left-radius: 4px; }
  .bubble.error { align-self: stretch; max-width: none; background: color-mix(in srgb, var(--danger) 12%, transparent); color: var(--danger); }
  .chat-empty { margin: auto; text-align: center; color: var(--muted); padding: 24px; }
  .chat-empty .chips { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin-top: 12px; }
  .chip { padding: 6px 11px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); color: var(--text); cursor: pointer; font: inherit; font-size: 0.85rem; }
  .chip:hover { border-color: var(--accent); color: var(--accent); }
  .chat-status { padding: 0 16px; min-height: 1.4em; }
  .chat-form { display: flex; gap: 8px; padding: 12px 16px 16px; border-top: 1px solid var(--border); }
  .chat-form textarea { flex: 1; }

  /* toast */
  .toast {
    position: fixed; z-index: 60; left: 50%; bottom: 24px; transform: translateX(-50%);
    padding: 11px 18px; border-radius: 12px; background: var(--text); color: var(--bg);
    box-shadow: var(--shadow-lg); font-weight: 500; max-width: calc(100vw - 32px);
  }

  /* modal */
  dialog.modal {
    border: 1px solid var(--border); border-radius: 18px; padding: 0; width: min(520px, calc(100vw - 32px));
    background: var(--surface); color: var(--text); box-shadow: var(--shadow-lg);
  }
  dialog.modal::backdrop { background: rgb(0 0 0 / 0.35); }
  .modal-body { padding: 20px; display: grid; gap: 14px; }
  .modal-foot { display: flex; gap: 8px; justify-content: flex-end; padding: 14px 20px; border-top: 1px solid var(--border); }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

  @media (max-width: 720px) {
    .topbar { flex-wrap: wrap; padding: 10px 16px; gap: 10px; }
    .tabs { order: 3; width: 100%; margin: 0; overflow-x: auto; }
    .ai-open span { display: none; }
    .page { padding: 16px 16px 48px; }
    .grid-2 { grid-template-columns: 1fr; }
  }
</style>
